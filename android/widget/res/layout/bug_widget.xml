<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bw_bg" android:padding="14dp">
    <LinearLayout android:id="@+id/bw_head"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Autopilot" android:textColor="#ffffff" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/bw_sub" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="8dp" android:maxLines="1"
            android:textColor="#8b93a7" android:textSize="11sp" />
        <TextView android:id="@+id/bw_counts" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🐞 –   ✨ –" android:textColor="#e2e8f0" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingTop="6dp">
        <TextView android:id="@+id/bw_r0" style="@style/BwRow" />
        <TextView android:id="@+id/bw_r1" style="@style/BwRow" />
        <TextView android:id="@+id/bw_r2" style="@style/BwRow" />
        <TextView android:id="@+id/bw_r3" style="@style/BwRow" />
        <TextView android:id="@+id/bw_r4" style="@style/BwRow" />
        <TextView android:id="@+id/bw_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="6dp" android:text="ไม่มีงานค้าง 🎉" android:textColor="#8b93a7" android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="10dp">
        <TextView android:id="@+id/bw_add_bug" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bw_btn" android:gravity="center"
            android:paddingTop="11dp" android:paddingBottom="11dp"
            android:text="+ Bug" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/bw_add_feat" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:background="@drawable/bw_btn_feat"
            android:gravity="center" android:paddingTop="11dp" android:paddingBottom="11dp"
            android:text="+ ฟีเจอร์" android:textColor="#ffffff" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
